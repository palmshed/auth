{
  "name": "@palmshed/auth-core",
  "version": "1.0.0",
  "description": "Framework-agnostic authentication engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
