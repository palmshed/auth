{
  "name": "palmshed-auth",
  "private": true,
  "description": "Authentication platform for Palmshed projects",
  "workspaces": [
    "packages/*",
    "apps/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "tsc --noEmit",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "postgres": "^3.4.9",
    "@types/node": "^26.1.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
