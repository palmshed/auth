# ──────────────────────────────────
# palmshed/auth — environment variables
# ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Database ─────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/palmshed_auth

# ─── Captcha ─────────────────────
# Supported providers: hcaptcha, turnstile
CAPTCHA_PROVIDER=hcaptcha
HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
CAPTCHA_SECRET=your_captcha_secret

# ─── Email (Resend) ──────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=auth@your-domain.com

# ─── Application ─────────────────
PUBLIC_BASE_URL=https://palmshed.github.io
ALLOWED_ORIGIN=https://palmshed.github.io
