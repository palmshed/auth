# ──────────────────────────────────
# palmshed/auth — environment variables
# ──────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─── Database ─────────────────────
DATABASE_URL=:memory:

# ─── Captcha ─────────────────────
# Supported providers: hcaptcha, turnstile, none
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# ─── Email (Resend) ──────────────
RESEND_API_KEY=
RESEND_FROM=auth@palmshed.com

# ─── Application ─────────────────
ALLOWED_ORIGIN=https://palmshed.github.io

# ─── Session ─────────────────────
SESSION_EXPIRES_IN=604800000
SESSION_IDLE_TIMEOUT=14400000
SESSION_ABSOLUTE_LIFETIME=2592000000
MAX_CONCURRENT_SESSIONS=10

# ─── Rate Limiting ───────────────
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_MS=900000
